datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Game {
  id                String         @id                    // Stable fingerprint UUID
  directoryPath     String         @unique                // Absolute path in container
  directoryName     String                                // Raw directory name
  extractedTitle    String                                // Title from options.rpy or dir name
  vndbId            String?                               // e.g. "v17"
  steamAppId        String?                               // Steam application ID
  vndbTitle         String?                               // English title from VNDB
  vndbTitleOriginal String?                               // Japanese/original title
  synopsis          String?                               // Full synopsis
  developer         String?                               // Developer studio
  releaseDate       DateTime?                             // First release date
  lengthMinutes     Int?                                  // Estimated play time
  vndbRating        Float?                                // Score 0-10
  coverPath         String?                               // Local path to cached cover
  tags              String         @default("[]")         // JSON array of { id, name, spoiler }
  screenshots       String         @default("[]")         // JSON array of screenshot URLs
  buildStatus       String         @default("not_built")  // not_built|queued|building|built|failed|stale
  hidden            Boolean        @default(false)        // User-hidden from library view
  publishStatus     String         @default("not_published") // not_published|publishing|published|failed (R2 mode only)
  publishedAt       DateTime?                             // Last successful publish time
  publishedVersion  String?                               // Hash of published build
  favorite          Boolean        @default(false)        // DEPRECATED — kept for data migration; will be dropped in a follow-up migration
  buildJobId        String?                               // Most recent build job ID
  builtAt           DateTime?                             // Last successful build time
  webBuildPath      String?                               // URL to compiled web export
  webSaveDirectory  String?                               // Literal default captured by the web build
  metadataSource    String         @default("unmatched")  // auto|manual|unmatched
  metadataFetchedAt DateTime?                             // Last VNDB fetch time
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  favoritedBy       UserFavorite[]                        // Per-user favorites (replaces global favorite)
  saveDirectories  SaveRuntimeDirectory[]
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String                                     // bcrypt hash (cost factor 12)
  role         String         @default("viewer")          // "admin" | "viewer"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  favorites    UserFavorite[]
  saves        SaveSyncState[]
  saveVersions SaveVersion[]
  saveReceipts SaveUploadReceipt[]
  saveDirectories SaveRuntimeDirectory[]
  saveIdentities SaveGameIdentity[]
}

// Identity survives absent games so backups can be restored before game import.
model SaveGameIdentity {
  userId String
  gameId String
  directoryName String?
  gameTitle String
  saveDirectory String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, gameId])
}

// Runtime metadata is independent of snapshots: launching need not create a save.
model SaveRuntimeDirectory {
  userId    String
  gameId    String
  directory String
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

model SaveSyncState {
  userId    String
  gameId    String
  gameTitle String   @default("")
  uploadId  String?
  currentVersionId String?
  revision  Int      @default(1)
  payload   String   // Compact live manifest, or legacy inline base64 snapshot.
  checksum  String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     SaveCurrentFile[]

  @@id([userId, gameId])
}

// History is separate from the live Ren'Py filesystem. Identical file bytes
// are shared by manifests even when Ren'Py rotates them between autosave slots.
model SaveFileBlob {
  hash     String @id
  data     Bytes
  size     Int
  preview  String? // Bounded presentation-only JSON, cached by immutable hash.
  files    SaveVersionFile[]
  currentFiles SaveCurrentFile[]
}

model SaveCurrentFile {
  userId String
  gameId String
  path   String
  mtime  Float
  hash   String
  state  SaveSyncState @relation(fields: [userId, gameId], references: [userId, gameId], onDelete: Cascade)
  blob   SaveFileBlob @relation(fields: [hash], references: [hash])

  @@id([userId, gameId, path])
  @@index([hash])
}

model SaveVersion {
  id           String   @id @default(uuid())
  userId       String
  gameId       String
  gameTitle    String
  kind         String   // auto | manual | checkpoint | restored
  alternate    Boolean  @default(false)
  branchId     String?
  baseRevision Int
  revision     Int
  deviceLabel  String
  checksum     String
  saveChecksum String
  byteSize     Int
  restoredFrom String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files        SaveVersionFile[]

  @@index([userId, gameId, createdAt])
  @@index([userId, gameId, branchId])
}

model SaveVersionFile {
  versionId String
  path      String
  mtime     Float
  hash      String
  version   SaveVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  blob      SaveFileBlob @relation(fields: [hash], references: [hash])

  @@id([versionId, path])
  @@index([hash])
}

// Lightweight receipts outlive pruned history so lost-response retries remain
// idempotent even after another device saves or a version expires.
model SaveUploadReceipt {
  userId      String
  gameId      String
  uploadId    String
  checksum    String
  revision    Int
  disposition String
  versionId   String?
  branchId    String?
  saveChecksum String
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameId, uploadId])
}

model UserFavorite {
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

model BuildJob {
  id          String    @id @default(uuid())
  gameId      String
  status      String    @default("queued")    // queued|building|done|failed|cancelled
  logPath     String?                         // Path to build log file
  startedAt   DateTime?
  completedAt DateTime?
  error       String?                         // Error message if failed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ScanJob {
  id              String    @id @default(uuid())
  status          String    @default("running")  // running|completed|failed
  gamesFound      Int       @default(0)
  gamesNew        Int       @default(0)
  gamesRemoved    Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
}

// ── R2 Publish models (only present in vnm-r2.db) ────────
// Applied via raw SQL in R2 mode; never via a Prisma migration so that
// vnm.db (the non-R2 database) remains clean.

model Setting {
  key       String   @id
  value     String                  // AES-256-GCM encrypted for secrets
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublishJob {
  id            String    @id @default(uuid())
  gameId        String
  status        String    @default("queued")    // queued|uploading|done|failed|cancelled
  progress      Int       @default(0)           // 0-100 percentage
  filesTotal    Int       @default(0)
  filesUploaded Int       @default(0)
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
