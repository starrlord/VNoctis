{
  "name": "vnm-ui",
  "version": "1.0.2",
  "private": true,
  "description": "VNoctis Manager — React UI (Vite + Tailwind CSS)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:renpy": "node test/runtime-integration.cjs",
    "test:save-worker": "node test/save-worker-integration.cjs",
    "test:player": "npm run build && node test/player-integration.cjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.5"
  }
}
